{
    "name": "k8sdockside-openbao-plugin",
    "version": "1.0.0",
    "private": true,
    "description": "The OpenBao & Vault plugin for K8s Dockside: seal state, HA topology, and which workloads get which secrets.",
    "license": "Apache-2.0",
    "author": "K8s Dockside",
    "repository": {
        "type": "git",
        "url": "https://github.com/k8sdockside/openbao"
    },
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "watch": "node scripts/build.mjs --watch",
        "preview": "node scripts/preview.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check": "npm run typecheck && npm run test && node scripts/build.mjs --check"
    },
    "devDependencies": {
        "esbuild": "0.28.2",
        "happy-dom": "^20.0.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    }
}
